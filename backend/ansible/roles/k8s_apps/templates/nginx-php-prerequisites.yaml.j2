---
apiVersion: v1
kind: Namespace
metadata:
  name: "{{ _k8s_app.namespace | default('nginx-php') }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-php-configmap
  namespace: "{{ _k8s_app.namespace | default('nginx-php') }}"
data:
  99-nginx.conf: |
    server {
        listen 80;
        server_name {{ _k8s_app.nginx.fqdn | default('nginx-php.local') }};
        root /var/www/html;
        index index.php index.html;
{% for site in _k8s_app.nginx.sites %}
{% if site.path == "/" %}
        # ----------------------------------------------------
        # Site /
        # ----------------------------------------------------
        location / {
            try_files $uri $uri/ /index.php?$query_string;
            
            location ~ \.php$ {
                # Check that the PHP file exists before passing to PHP-FPM
                try_files $uri =404;
                fastcgi_pass 127.0.0.1:9000;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            }
        }
{% else %}
        # ----------------------------------------------------
        # Site {{ site.path }}
        # ----------------------------------------------------
        # Handle {{ site.path }} (without trailing slash) by redirecting to {{ site.path }}/
        location = {{ site.path }} {
            return 301 {{ site.path }}/;
        }
        
        location ^~ {{ site.path }}/ {
            try_files $uri $uri/ {{ site.path }}/index.php?$query_string;
            
            location ~ \.php$ {
                # Check that the PHP file exists before passing to PHP-FPM
                try_files $uri =404;
                fastcgi_pass 127.0.0.1:9000;
                fastcgi_index index.php;
                include fastcgi_params;
                fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            }
        }
{% endif %}
{% endfor %}
    }

  zzz-php-fpm.conf: |
    [global]
    daemonize = no
    
    [www]
    listen = 127.0.0.1:9000
    
    ; ### Process manager optimized for low memory
    pm = ondemand
    pm.max_children = 2
    pm.process_idle_timeout = 10s
    pm.max_requests = 500

  99-modsecurity.conf: |
    ### Global Engine Configuration
    # Enable rule engine (On = Block, DetectionOnly = Log only)
    SecRuleEngine On
    SecRequestBodyAccess On
    SecAuditEngine RelevantOnly 
    SecAuditLogType Serial
    SecAuditLogParts ABHIJKZ
    SecAuditLogFormat JSON
    SecAuditLog /dev/stdout
    ### Global Thresholds of OWASP CRS
    # Configure Anomaly Thresholds
    SecAction "id:900110,phase:1,nolog,pass,t:none,setvar:tx.inbound_anomaly_score_threshold=5,setvar:tx.outbound_anomaly_score_threshold=4"
    # Configure Paranoia Level (1-4)
    SecAction "id:900000,phase:1,nolog,pass,t:none,setvar:tx.paranoia_level=1"
        
    ### App-specifc Engine Configuration
    # SecRule REQUEST_URI "@beginsWith /api/onboarding/users" "id:1001,phase:2,pass,nolog,ctl:ruleRemoveById=949110"

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: nginx-php-pv-wwwdata
  namespace: "{{ _k8s_app.namespace | default('nginx-php') }}"
  labels:
    app: nginx-php-app
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: "{{ _k8s_app.storage.size | default('1Gi') }}"
  storageClassName: "{{ _k8s_app.storage.class_name | default('') }}"
