# based on:
# - https://blog.quadmeup.com/2025/07/09/mosquitto-in-kubernetes-the-simple-way/
# - https://github.com/abalage/mosquitto-mqtt-k8s
---
apiVersion: v1
kind: Service
metadata:
  name: mosquitto-service
  namespace: "{{ _k8s_app.namespace | default('mosquitto') }}"
  labels:
    app: mosquitto-app
spec:
  type: ClusterIP
  ports:
    - port: 1883
      targetPort: 1883
      name: mqtt
    - port: 9001
      targetPort: 9001
      name: websocket
  selector:
    app: mosquitto-app
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mosquitto-app
  namespace: "{{ _k8s_app.namespace | default('mosquitto') }}"
  labels:
    app: mosquitto-app
spec:
  replicas: 1
  strategy:
    # Recreate Deployment Strategy (non-default): https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#strategy
    type: Recreate
  # Revision History: https://kubernetes.io/docs/concepts/workloads/controllers/deployment/#revision-history-limit
  revisionHistoryLimit: 1
  selector:
    matchLabels:
      app: mosquitto-app
  template:
    metadata:
      labels:
        app: mosquitto-app
    spec:
      securityContext:
        # HARDENING POD-LEVEL: Run as Non-Root User
        runAsNonRoot: true
        runAsUser: 1883
        runAsGroup: 1883
        fsGroup: 1883
        # HARDENING POD-LEVEL: Enable Secure Computing Mode
        seccompProfile:
          type: RuntimeDefault
      containers:
        - image: "eclipse-mosquitto:{{ _k8s_app.version }}{{ '-alpine' if _k8s_app.version is version('2.1.0', '>=' else '-openssl' }}"
          name: mosquitto
{% if _k8s_app.version is version('2.1.0', '>=') and _k8s_app.version is version('2.1.4', '<=') %}
          # BUG WORKAROUND: https://github.com/eclipse-mosquitto/mosquitto/issues/3465#issuecomment-7070761509
          command: ["/usr/sbin/mosquitto"]
          args: ["-c", "/mosquitto/config/mosquitto.conf"]
{% endif %}
          env:
            # BREAKING CHANGE SINCE v2.1 / Feature since v2.1.1: Allow Symlinks in safe environments like Kubernetes (https://mosquitto.org/blog/2026/02/version-2-1-1-released/)
            - name: MOSQUITTO_UNSAFE_ALLOW_SYMLINKS
              value: "ANY"
          securityContext:
            # HARDENING CONTAINER-LEVEL: Disable Privilege Escalation
            allowPrivilegeEscalation: false
            # HARDENING CONTAINER-LEVEL: Restrict Linux Capabilities
            capabilities:
              drop: ["ALL"]
            # HARDENING CONTAINER-LEVEL: Set Root Filesystem to Read-Only
            readOnlyRootFilesystem: true
          resources:
            requests:
              memory: "32Mi"
              cpu: "10m"
            limits:
              memory: "64Mi"
              cpu: "250m"
          ports:
            - containerPort: 1883
              name: mqtt
            - containerPort: 9001
              name: websocket
          volumeMounts:
            # - name: mosquitto-pv-config
            #   mountPath: /mosquitto/config
            - name: mosquitto-secret-config
              mountPath: /mosquitto/password_file
              readOnly: true
            - name: mosquitto-configmap-config
              mountPath: /mosquitto/config
              readOnly: true
      volumes:
        # - name: mosquitto-pv-config
        #   persistentVolumeClaim:
        #    claimName: mosquitto-pv-config
        - name: mosquitto-configmap-config
          configMap:
            name: mosquitto-configmap-config
            defaultMode: 0640
        - name: mosquitto-secret-config
          secret:
            secretName: mosquitto-secret-config
            defaultMode: 0640
